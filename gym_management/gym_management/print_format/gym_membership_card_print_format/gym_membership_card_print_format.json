 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body {\n    font.membership-card {\n    width: 360px;\n    height: 230px;\n    padding: 18px;\n    border-radius: 14px;\n    display: flex;\n    gap: 15px;\n    color: #ffffff;\n    font-family: \"Poppins\", Arial, sans-serif;\n    background: linear-gradient(135deg, #ff6a00, #ee0979, #3a1c71);\n    background-size: 300% 300%;\n    animation: gradientMove 6s infinite alternate;\n    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.35);\n    border: 2px solid rgba(255, 255, 255, 0.3);\n}\n\n@keyframes gradientMove {\n    0% { background-position: left top; }\n    100% { background-position: right bottom; }\n}\n\n.member-photo img {\n    width: 85px;\n    height: 85px;\n    border-radius: 10px;\n    object-fit: cover;\n    border: 2px solid #fff;\n    box-shadow: 0 0 8px rgba(255,255,255,0.5);\n}\n\n.member-details {\n    font-size: 13px;\n    line-height: 1.35;\n}\n\n.member-details h2 {\n    margin: 0 0 6px 0;\n    font-size: 16px;\n    font-weight: 700;\n    text-shadow: 1px 1px 3px rgba(0,0,0,0.4);\n}\n\n.member-details p {\n    margin: 2px 0;\n}\n\n.label {\n    font-weight: bold;\n    color: #ffffa8;\n}\n\n.card-footer {\n    position: absolute;\n    bottom: 8px;\n    right: 12px;\n    font-size: 10px;\n    opacity: 0.9;\n}\n\n\n    </style>\n</head>\n<body>\n\n{% set membership = frappe.get_doc(\"Gym Membership\", doc.gym_membership) %}\n{% set member = frappe.get_doc(\"Gym Member\", membership.gym_member) %}\n\n{# Prepare QR data containing all details #}\n{% set qr_data = \n    \"Name: \" ~ member.full_name ~ \"\\n\" ~\n    \"Membership ID: \" ~ membership.name ~ \"\\n\" ~\n    \"Plan: \" ~ membership.plan_name ~ \"\\n\" ~\n    \"Start Date: \" ~ membership.start_date ~ \"\\n\" ~\n    \"End Date: \" ~ membership.end_date ~ \"\\n\" ~\n    \"Status: \" ~ membership.status\n%}\n\n<div class=\"card\">\n\n    {# Member Photo #}\n    {% if member.photo %}\n        <img src=\"{{ member.photo }}\" class=\"member-photo\">\n    {% endif %}\n\n    <div class=\"details\">\n        <strong>Name:</strong> {{ member.full_name }}<br>\n        <strong>Membership ID:</strong> {{ membership.name }}<br>\n        <strong>Plan:</strong> {{ membership.plan_name}}<br>\n        <strong>Start Date:</strong> {{ membership.start_date }}<br>\n        <strong>End Date:</strong> {{ membership.end_date }}<br>\n        <strong>Status:</strong> {{ membership.status }}<br>\n    </div>\n\n    {# QR Code with all member details #}\n    <img class=\"qr\"\n         src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ qr_data | urlencode }}&size=80x80\">\n</div>\n\n</body>\n</html>",
