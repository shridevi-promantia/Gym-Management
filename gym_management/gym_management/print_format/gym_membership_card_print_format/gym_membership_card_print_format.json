 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n       .card {\n    width: 450px;\n    height: 260px;\n    padding: 15px;\n    background: url(\"/assets/gym_management/files/images.jpeg\") no-repeat center center;\n    background-size: cover;\n    border-radius: 12px;\n    color: white;\n    font-family: Arial, sans-serif;\n    position: relative;\n}\n\n/* Member Photo */\n.photo {\n    width: 90px;\n    height: 90px;\n    border: 2px solid #fff;\n    border-radius: 8px;\n    overflow: hidden;\n    float: left;\n}\n.photo img {\n    width: 90px;\n    height: 90px;\n}\n\n/* Details */\n.details {\n    margin-left: 110px;\n    margin-top: 5px;\n    color: white;\n}\n.details h2 {\n    margin: 0px;\n    font-size: 20px;\n    font-weight: bold;\n}\n.details p {\n    margin: 3px 0;\n    font-size: 14px;\n}\n\n/* QR Section */\n.qr {\n    position: absolute;\n    bottom: 10px;\n    right: 10px;\n}\n.qr img {\n    width: 80px;\n    height: 80px;\n}\n    </style>\n</head>\n<body>\n\n{% set membership = frappe.get_doc(\"Gym Membership\", doc.gym_membership) %}\n{% set member = frappe.get_doc(\"Gym Member\", membership.gym_member) %}\n\n{# Prepare QR data containing all details #}\n{% set qr_data = \n    \"Name: \" ~ member.full_name ~ \"\\n\" ~\n    \"Membership ID: \" ~ membership.name ~ \"\\n\" ~\n    \"Plan: \" ~ membership.plan_name ~ \"\\n\" ~\n    \"Start Date: \" ~ membership.start_date ~ \"\\n\" ~\n    \"End Date: \" ~ membership.end_date ~ \"\\n\" ~\n    \"Status: \" ~ membership.status\n%}\n\n<div class=\"card\">\n    <div class=\"photo\">\n    {# Member Photo #}\n    {% if member.photo %}\n        <img src=\"{{ member.photo }}\" class=\"member-photo\">\n    {% endif %}\n    </div>\n    <div class=\"details\">\n        <p><strong>Name:</strong> {{ member.full_name }}</p>\n        <p><strong>Membership ID:</strong> {{ membership.name }}</p>\n        <p><strong>Plan:</strong> {{ membership.plan_name}}</p>\n        <p><strong>Start Date:</strong> {{ membership.start_date }}</p>\n        <p><strong>End Date:</strong> {{ membership.end_date }}</p>\n        <p><strong>Status:</strong> {{ membership.status }}</p>\n    </div>\n\n    {# QR Code with all member details #}\n    <img class=\"qr\"\n         src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ qr_data | urlencode }}&size=80x80\">\n</div>\n\n</body>\n</html>",
